{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "*.min.js",
    "*.tsbuildinfo",
    "coverage",
    "dist",
    "dist-*",
    "dist-tizen",
    "dist-tizen-legacy",
    "dist-webos",
    "node_modules",
    "platforms/**/dist"
  ]
}
