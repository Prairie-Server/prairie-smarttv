{
  "name": "prairie-smarttv",
  "version": "0.1.0",
  "private": true,
  "description": "AGPL Prairie client for Samsung Tizen and LG webOS",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:web": "node scripts/build-web.mjs",
    "build:tizen": "node scripts/build-web.mjs --platform tizen",
    "build:webos": "node scripts/build-web.mjs --platform webos",
    "package:tizen": "node scripts/package-store.mjs tizen",
    "package:webos": "node scripts/package-store.mjs webos",
    "package:store": "node scripts/package-store.mjs all",
    "sign:tizen": "node scripts/sign-tizen.mjs",
    "stamp-version": "node scripts/stamp-version.mjs",
    "build:tizen-legacy:web": "vite build --config vite.tizen-legacy.config.ts",
    "build:tizen-legacy": "node scripts/build-web.mjs --platform tizen-legacy",
    "package:tizen-legacy": "node scripts/package-store.mjs tizen-legacy"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/sora": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
