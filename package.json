{
  "name": "prairie-smarttv",
  "version": "1.0.0",
  "private": true,
  "description": "AGPL Prairie client for Samsung Tizen and LG webOS",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:web": "node scripts/build-web.mjs",
    "build:tizen": "node scripts/build-web.mjs --platform tizen",
    "build:webos": "node scripts/build-web.mjs --platform webos",
    "package:tizen": "node scripts/package-store.mjs tizen",
    "package:webos": "node scripts/package-store.mjs webos",
    "package:store": "node scripts/package-store.mjs all",
    "stamp-version": "node scripts/stamp-version.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/sora": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.3",
    "vitest": "^3.2.7"
  }
}
