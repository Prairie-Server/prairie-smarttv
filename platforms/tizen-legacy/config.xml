<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://prairieserver.org/prairie-smarttv-legacy"
        version="0.1.5"
        viewmodes="maximized">
  <!-- Distinct 10-char package id so modern + legacy can both be sideloaded. -->
  <tizen:application id="PrairieLte.Lite" package="PrairieLte" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Prairie Lite</name>
  <description>Prairie media client for older Samsung Tizen WebKits (legacy build)</description>
  <author href="https://github.com/Prairie-Server/prairie-smarttv">Prairie</author>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/download"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <access origin="*" subdomains="true"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" encryption="disable"
                 install-location="auto" hwkey-event="enable"/>
</widget>
