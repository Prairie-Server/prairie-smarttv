<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://prairieserver.org/prairie-smarttv"
        version="0.1.7"
        viewmodes="maximized">
  <!-- Package id must be 10 alphanumeric chars (Tizen Studio / TV install rule). -->
  <!-- required_version is the install floor only — keep low like Litefin/Moonfin so Public Apps2Samsung certs work. -->
  <tizen:application id="PrairieApp.Prairie" package="PrairieApp" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Prairie</name>
  <description>Prairie media client for Samsung Tizen</description>
  <author href="https://github.com/Prairie-Server/prairie-smarttv">Prairie</author>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/download"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <access origin="*" subdomains="true"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" encryption="disable"
                 install-location="auto" hwkey-event="enable"/>
  <!-- download + filesystem.read: remote subtitle_urls → wgt-private-tmp for AVPlay. -->
  <!-- tvinfo omitted (optional caption control; soft-fails in code) so install matches Litefin/Public certs. -->
</widget>
