<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://prairieserver.org/prairie-smarttv"
        version="0.1.0-beta1"
        viewmodes="maximized">
  <tizen:application id="prairie.PrairieSmartTV" package="prairie" required_version="6.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1920.1080"/>
  <icon src="icon.png"/>
  <name>Prairie</name>
  <description>Prairie media client for Samsung Tizen</description>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/download"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/tvinfo"/>
  <access origin="*" subdomains="true"/>
  <!-- Build with: npm run build:tizen → package dist-tizen/ via Tizen Studio / tizen CLI. -->
  <!-- download + filesystem.read: remote subtitle_urls → wgt-private-tmp for AVPlay. -->
</widget>
